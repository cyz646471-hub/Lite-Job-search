{
  "name": "lite-job-search",
  "version": "0.1.0",
  "description": "Standalone China and North America job discovery, official-site verification and ATS crawling skill.",
  "type": "module",
  "private": false,
  "bin": {
    "lite-job-search": "./bin/lite-job-search.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    ".agents/skills/lite-job-search",
    "bin",
    "config",
    "docs/architecture.md",
    "docs/migration-from-career-ops.md",
    "examples",
    "engine",
    "scripts",
    "src"
  ],
  "scripts": {
    "test": "node --test",
    "doctor": "node ./bin/lite-job-search.mjs doctor",
    "sync:career-ops": "node ./scripts/sync-from-career-ops.mjs",
    "validate:skill": "node --test tests/skill-package.test.mjs",
    "test:market-discovery": "node --test tests/domain-models.test.mjs tests/verification-engine.test.mjs tests/query-planner.test.mjs tests/company-discovery.test.mjs tests/upstream-adapters.test.mjs tests/sqlite-repository.test.mjs tests/discover-market-jobs.test.mjs tests/market-discovery-cli.test.mjs tests/fetch-page.test.mjs tests/llm-planning-adapter.test.mjs tests/occupation-taxonomy.test.mjs tests/quality-report.test.mjs tests/discovery-batch.test.mjs",
    "canary:ai-product-manager": "node ./scripts/run-ai-product-manager-canary.mjs",
    "canary": "node ./bin/lite-job-search.mjs discover",
    "discover:batch": "node ./bin/lite-job-search.mjs discover-batch",
    "test:local-worker": "node --test tests/recruitment-event.test.mjs tests/recruitment-source-policy.test.mjs tests/recruitment-event-classifier.test.mjs tests/browser-search-circuit-breaker.test.mjs tests/platform-company-page-adapter.test.mjs tests/company-browser-discovery.test.mjs tests/browser-company-batch.test.mjs tests/browser-worker-cli.test.mjs tests/persistent-browser-supervisor.test.mjs tests/sqlite-repository.test.mjs tests/discover-market-jobs.test.mjs",
    "test:instruction": "node --test tests/search-instruction.test.mjs tests/task-company-resolver.test.mjs tests/search-instruction-cli.test.mjs",
    "discover:browser-companies": "node ./scripts/run-persistent-browser-supervisor.mjs",
    "discover:local-worker": "node ./scripts/run-persistent-browser-supervisor.mjs",
    "discover:persistent-supervisor": "node ./scripts/run-persistent-browser-supervisor.mjs",
    "discover:instruction": "node ./scripts/run-search-instruction.mjs",
    "control": "node ./scripts/ljs-control.mjs",
    "web": "node ./scripts/run-local-control-plane.mjs",
    "diagnose:chrome": "node ./scripts/diagnose-browser-search-challenge.mjs",
    "task:run": "node ./scripts/run-control-task.mjs",
    "prepare:full-recheck": "node ./scripts/prepare-full-database-maintenance.mjs",
    "monitor:fixed-pool:prepare": "node ./scripts/prepare-fixed-company-monitor.mjs",
    "monitor:fixed-pool": "node ./scripts/run-fixed-company-monitor.mjs",
    "watch:new-companies:prepare": "node ./scripts/prepare-new-company-watch.mjs",
    "watch:new-companies": "node ./scripts/run-new-company-watch.mjs",
    "discover:cn-market": "node ./scripts/discover-cn-market-companies.mjs",
    "discover:cn-market:cycle": "node ./scripts/run-cn-market-discovery-cycle.mjs",
    "report:product-closure": "node ./scripts/report-product-closure.mjs",
    "maintenance:series": "node ./scripts/run-full-maintenance-series.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "job-search",
    "career",
    "china",
    "north-america",
    "ats",
    "agent-skill"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.0.0",
    "js-yaml": "^4.1.1",
    "playwright": "1.61.1",
    "tldts": "7.4.9"
  }
}
