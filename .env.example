# Search routing
SEARCH_PROVIDER_PRIMARY=none
SEARCH_PROVIDER_FALLBACK=none
SEARCH_TIMEOUT_MS=15000
SEARCH_MAX_RESULTS=8
SEARCH_DAILY_QUERY_BUDGET=300
SEARCH_CACHE_TTL_DAYS=14

# China providers
CN_BAIDU_SEARCH_MODE=chrome
BAIDU_SEARCH_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
APIFY_TOKEN=
APIFY_DAILY_BUDGET_USD=1.00
APIFY_MONTHLY_BUDGET_USD=4.50
APIFY_ALLOW_RESIDENTIAL_PROXY=false

# Optional browser/runtime
PLAYWRIGHT_HEADLESS=true
LITE_JOB_SEARCH_CACHE_DIR=./cache

# Role-driven market discovery (no endpoint or model defaults)
LITE_JOB_LLM_ENDPOINT=
LITE_JOB_LLM_MODEL=
LITE_JOB_LLM_API_KEY=
LITE_JOB_LLM_TIMEOUT_MS=30000
LITE_JOB_DATABASE_FILE=./data/lite-job-search.sqlite
LITE_JOB_DISCOVERY_MAX_QUERIES=12
LITE_JOB_DISCOVERY_MAX_RESULTS=100

